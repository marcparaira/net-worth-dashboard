# API image. Build from the repository root:
#   podman build -f backend/Containerfile -t net-worth-api .

# --- Build stage: install dependencies into a virtual environment.
FROM docker.io/library/python:3.13-alpine AS build
RUN python -m venv /opt/venv
ENV PATH=/opt/venv/bin:$PATH
COPY backend/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt

# --- Runtime stage: the virtual environment and the application code only.
FROM docker.io/library/python:3.13-alpine AS runtime
RUN addgroup -S app && adduser -S -G app app
WORKDIR /app
COPY --from=build /opt/venv /opt/venv
COPY backend/ backend/
COPY sample-data/ sample-data/
# Release version, passed by the release workflow (--build-arg APP_VERSION=1.2.3).
ARG APP_VERSION=dev
ENV PATH=/opt/venv/bin:$PATH \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    APP_VERSION=$APP_VERSION
USER app
EXPOSE 8000
CMD ["uvicorn", "backend.app:app", "--host", "0.0.0.0", "--port", "8000"]
