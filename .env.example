# Copy to .env (never committed) and adjust.
# Directory with your own records/ and rebalancing.json, for the import command
# (python -m backend.importer). Leave unset to import sample-data/.
NET_WORTH_DATA_DIR=${HOME}/net-worth-data

# Host ports for `podman compose` (defaults: 5173, 8000, 5432).
# WEB_PORT=5173
# API_PORT=8000
# DB_PORT=5432
